{
  "name": "@planetscale/auth-action",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticate to the PlanetScale API with OpenID Connect",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "pack": "rolldown -c",
    "test": "echo \"Error: no test specified\" && exit 1",
