    "format": "oxfmt src package.json",
    "format-check": "oxfmt --check src package.json",
    "all": "npm run build && npm run format && npm run lint && npm run pack"
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
